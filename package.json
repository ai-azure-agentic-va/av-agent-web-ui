{
  "name": "open-web-ui",
  "private": true,
  "version": "3.8.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "dev:ets": "NEXT_PUBLIC_DESIGN_SYSTEM=ets next dev",
    "build:ets": "NEXT_PUBLIC_DESIGN_SYSTEM=ets next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "//": "Versions are EXACT-PINNED (no ^ / ~). Docker runs `pnpm install --frozen-lockfile`, so the committed pnpm-lock.yaml + these exact specifiers make image builds reproducible instead of floating within caret ranges on each rebuild. Bump deliberately, then run `pnpm install` to refresh the lockfile. Upgraded 2026-11-11 to Next 16.4.6 (+ eslint-config-next 16.4.6; 16.0.0-16.4.0 carry critical RCE advisories GHSA-2464-fhr4-w9xw / GHSA-673q-mjm6-r5xr, fixed in 16.4.1); Node >= 22 is now required (Docker/CI run Node 24 LTS) because @azure/identity 4.14 + @azure/keyvault-secrets 4.12 declare engines node>=22. Next 16 removed `next lint` and no longer lints during `next build`, so `lint` runs the ESLint CLI directly. Deliberately held below the latest major: typescript at 6.0.x (typescript-eslint 8.x peers typescript <6.1, so 7.x is unsupported). ESLint is on 10: eslint-config-next >=16.4.0 supports it (it wraps eslint-plugin-react / -import with fixupPluginRules), but those plugins still declare eslint <=9 peers, so pnpm.peerDependencyRules allows eslint 10 for exactly those three. pnpm.overrides pin ONE patched postcss and lodash across the whole tree (Next itself pins postcss 8.5.23), and force katex 0.19 under rehype-katex so the KaTeX HTML matches the katex.min.css imported in markdown-text.tsx.",
  "dependencies": {
    "@azure/identity": "4.14.1",
    "@azure/keyvault-secrets": "4.12.0",
    "@azure/msal-node": "7.2.1",
    "@langchain/core": "1.4.0",
    "@langchain/langgraph": "1.7.3",
    "@langchain/langgraph-sdk": "1.15.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-tailwindcss": "2.2.0",
    "framer-motion": "14.12.0",
    "geist": "1.9.2",
    "katex": "0.19.1",
    "langgraph-nextjs-api-passthrough": "0.1.4",
    "lodash": "4.18.1",
    "lucide-react": "1.72.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "nuqs": "2.10.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.2",
    "recharts": "3.10.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "use-stick-to-bottom": "1.1.6",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "next": "16.4.6",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "8.5.32",
      "lodash": "4.18.1",
      "katex": "0.19.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react>eslint": "10",
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  },
  "packageManager": "pnpm@10.5.1"
}
