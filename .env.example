# =============================================================================
# Open Web UI — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth / Session
# AUTH_SECRET : Random 32+ char string for signing the ets_session cookie.
# AUTH_URL    : Public base URL of this app (used for OAuth redirect URIs).
# -----------------------------------------------------------------------------
AUTH_SECRET=<random-32-char-secret>
AUTH_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Entra ID (Azure AD) — App Registration
# Register a redirect URI in Azure Portal:
#   http://localhost:8081/chat/auth/callback
# -----------------------------------------------------------------------------
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<frontend-app-client-id>
ENTRA_CLIENT_SECRET=<frontend-app-client-secret>

# -----------------------------------------------------------------------------
# Group-based access control (optional)
# When set, only members of these AD groups can log in; non-members are sent
# to /auth/access-denied. Leave BOTH blank to allow ALL authenticated users
# (current default — a loud "GROUP CHECK BYPASSED" warning is logged on login).
#
# Group resolution: the user's groups come from the ID token's "groups" claim
# when present. If that claim is empty (claim not configured, or user is over
# the ~200-group token limit), the app falls back to Microsoft Graph
# (transitiveMemberOf) automatically — see fetchUserGroupsFromGraph in
# src/lib/msal-auth.ts.
#
# To enable:
#   1. Set the group Object IDs from Azure Portal → Groups.
#   2. Grant the app registration the APPLICATION permission
#      "GroupMember.Read.All" (or "Directory.Read.All") in
#      Azure Portal → App Registrations → API Permissions → Add → Microsoft Graph.
#      Then click "Grant admin consent". (Required for the Graph fallback.)
#   3. (Optional) To emit groups directly in the token and skip the Graph call,
#      set groupMembershipClaims = "SecurityGroup" in Token configuration.
# -----------------------------------------------------------------------------
AI_VA_USERS_GROUP_ID=
AI_VA_ADMINS_GROUP_ID=

# -----------------------------------------------------------------------------
# Backend API scope for Bearer token forwarding
# This is the scope registered on the BACKEND app registration.
# The access token acquired with this scope is forwarded as:
#   Authorization: Bearer <access_token>
# on every LangGraph API call.
#
# Format : api://<backend-app-client-id>/access_as_user
# Leave blank if the backend does not validate Entra ID tokens.
# -----------------------------------------------------------------------------
API_SCOPE=api://<backend-app-client-id>/access_as_user

# -----------------------------------------------------------------------------
# LangGraph backend
# LANGGRAPH_API_URL : Server-to-server URL of the LangGraph agent.
#                     In Docker: use the service name (e.g. http://langgraph:8000).
#                     Locally: http://localhost:2024
# LANGSMITH_API_KEY : LangSmith API key (only needed for LangSmith-hosted graphs).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8081/api
NEXT_PUBLIC_ASSISTANT_ID=chat
LANGGRAPH_API_URL=http://localhost:2024
LANGSMITH_API_KEY=

# -----------------------------------------------------------------------------
# Azure Key Vault (optional) — fetch secrets at startup
# When AZURE_KEY_VAULT_URL is set, the app loads AUTH_SECRET, ENTRA_CLIENT_SECRET
# and LANGSMITH_API_KEY from Key Vault on boot (src/instrumentation.ts) and the
# values above can be left blank. Auth uses DefaultAzureCredential: a managed
# identity in Azure, or `az login` / env credentials locally — grant it the
# "Key Vault Secrets User" role on the vault.
#
# Leave AZURE_KEY_VAULT_URL blank to use the plain env vars above (local dev).
# The *_KV_NAME vars override the secret names looked up in the vault.
# -----------------------------------------------------------------------------
AZURE_KEY_VAULT_URL=
AUTH_SECRET_KV_NAME=auth-secret
ENTRA_CLIENT_SECRET_KV_NAME=entra-client-secret
LANGSMITH_API_KEY_KV_NAME=langsmith-api-key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=8081


# -----------------------------------------------------------------------------
# UI
# NEXT_PUBLIC_HIDE_TOOL_CALLS : When "true", tool calls / tool results are
#   force-hidden in the chat and the dev-only "Hide tool calls" toggle is
#   removed from the composer. Set to "true" for production builds; leave
#   "false" in dev to keep tool calls visible and toggleable.
# NEXT_PUBLIC_HIDE_SETTINGS_BUTTON : When "true", the Settings button under the
#   chat composer is hidden.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_HIDE_TOOL_CALLS=false
NEXT_PUBLIC_HIDE_SETTINGS_BUTTON=false


# -----------------------------------------------------------------------------
# Logging
# LOG_LEVEL : DEBUG | INFO | WARN | ERROR (default INFO). DEBUG enables verbose
#             auth diagnostics (requested/granted scopes, oid, email, group IDs).
#             Keep at INFO or higher in production — DEBUG logs sensitive data.
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Auth bypass — set BOTH to true for local dev without Azure AD.
# Remove or set to false before deploying.
# -----------------------------------------------------------------------------
DISABLE_AUTH=false
NEXT_PUBLIC_DISABLE_AUTH=false
