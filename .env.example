# =============================================================================
# Open Web UI — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth / Session
# AUTH_SECRET : Random 32+ char string for signing the ets_session cookie.
# AUTH_URL    : Public base URL of this app (used for OAuth redirect URIs).
# -----------------------------------------------------------------------------
AUTH_SECRET=<random-32-char-secret>
AUTH_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Entra ID (Azure AD) — App Registration
# Register a redirect URI in Azure Portal:
#   http://localhost:8081/chat/auth/callback
# -----------------------------------------------------------------------------
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<frontend-app-client-id>
ENTRA_CLIENT_SECRET=<frontend-app-client-secret>

# -----------------------------------------------------------------------------
# Group-based access control (optional)
# When set, only members of these AD groups can log in.
# Leave blank to allow ALL authenticated users (current default).
#
# To enable:
#   1. Set the group Object IDs from Azure Portal → Groups.
#   2. Grant the app registration the APPLICATION permission
#      "GroupMember.Read.All" (or "Directory.Read.All") in
#      Azure Portal → App Registrations → API Permissions → Add → Microsoft Graph.
#      Then click "Grant admin consent".
# -----------------------------------------------------------------------------
AI_VA_USERS_GROUP_ID=
AI_VA_ADMINS_GROUP_ID=

# -----------------------------------------------------------------------------
# Backend API scope for Bearer token forwarding
# This is the scope registered on the BACKEND app registration.
# The access token acquired with this scope is forwarded as:
#   Authorization: Bearer <access_token>
# on every LangGraph API call.
#
# Format : api://<backend-app-client-id>/access_as_user
# Leave blank if the backend does not validate Entra ID tokens.
# -----------------------------------------------------------------------------
API_SCOPE=api://<backend-app-client-id>/access_as_user

# -----------------------------------------------------------------------------
# LangGraph backend
# LANGGRAPH_API_URL : Server-to-server URL of the LangGraph agent.
#                     In Docker: use the service name (e.g. http://langgraph:8000).
#                     Locally: http://localhost:2024
# LANGSMITH_API_KEY : LangSmith API key (only needed for LangSmith-hosted graphs).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8081/api
NEXT_PUBLIC_ASSISTANT_ID=adf_agent
LANGGRAPH_API_URL=http://localhost:2024
LANGSMITH_API_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
PORT=8081

# -----------------------------------------------------------------------------
# Auth bypass — set BOTH to true for local dev without Azure AD.
# Remove or set to false before deploying.
# -----------------------------------------------------------------------------
DISABLE_AUTH=false
NEXT_PUBLIC_DISABLE_AUTH=false
